# TrustLens Environment Configuration

# Application
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=TrustLens
PIPELINE_VERSION=0.1.0
SCHEMA_VERSION=1.0.0

# Database (defaults to SQLite for local development)
DATABASE_URL=sqlite:///./trustlens.db

# Storage paths
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
NORMALIZED_DATA_DIR=./data/normalized
PROCESSED_DATA_DIR=./data/processed
LABELS_DATA_DIR=./data/labels

# Privacy & Security
# Used for HMAC-SHA256 one-way hashing of sensitive seller identifiers (phone, email)
HASH_SALT=trustlens_default_dev_salt_change_in_production

# Media download limits
MEDIA_MAX_FILE_SIZE_MB=50
MEDIA_DOWNLOAD_TIMEOUT_SEC=15
MEDIA_MAX_CONCURRENT_DOWNLOADS=5

# Web Extraction (Crawl4AI)
CRAWL4AI_HEADLESS=true
CRAWL4AI_TIMEOUT_MS=30000
